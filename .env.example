# HousingIQ — runtime configuration. Copy to .env and fill in real values
# before running the services. The .env file itself is gitignored.

# --- Shared ---
APP_DB_PATH=data/app.db

# --- Flask (web UI) ---
FASTAPI_BASE_URL=http://localhost:8000
FLASK_SECRET_KEY=replace-me-in-real-deploys
FLASK_DEBUG=false

# --- FastAPI (inference service) ---
MODELS_DIR=models
ANALYTICS_CACHE_DIR=data/processed/analytics_cache
PROCESSED_DATA_DIR=data/processed
