# Pipeline run-snapshot metadata (regenerable from raw; the .gitkeep keeps the dir tracked)
data/processed/_meta/*.json
!data/processed/_meta/.gitkeep

# Application SQLite DB (created at runtime by init_db())
data/app.db
data/app.db-journal